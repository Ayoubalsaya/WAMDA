# انسخ هذا الملف إلى .env واملأ القيم الحقيقية — .env لا يُرفع لأي مستودع.

# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://wamda_app:CHANGE_ME@localhost:5432/wamda_db

# منطقة العمل — §6-3 / §5-10
WORK_TIMEZONE=Africa/Tripoli

# بيئة التشغيل: local | production
# production يُفعّل HSTS ويُعطّل /docs و/redoc (§٩ المرحلة ١٢) — انظر README
APP_ENV=local

# §٩ المرحلة ١٢ — تحديد معدل مسارات الدخول لكل IP (نافذة منزلقة). القيم
# الافتراضية معقولة؛ اضبط فقط عند الحاجة. الموظف أضيق من العميل (شبكة ثابتة).
# قيد إلزامي حين APP_ENV=production (أعلاه): الخادم يرفض الإقلاع كلياً إن
# كان LOGIN_RATE_LIMIT_MAX أو PORTAL_LOGIN_RATE_LIMIT_MAX > 5، أو
# LOGIN_RATE_LIMIT_WINDOW_SECONDS < 900 (١٥ دقيقة). محلياً (APP_ENV=local)
# القيم حرة بلا أي قيد.
LOGIN_RATE_LIMIT_MAX=10
PORTAL_LOGIN_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# اجعلها true **فقط** على السيرفر خلف nginx يضبط X-Real-IP/X-Forwarded-For.
# محلياً وفي الاختبار: false (الثقة العمياء تسمح بتزوير العنوان وتجاوز الحدّ).
TRUST_PROXY_HEADERS=false

# تشفير أسرار 2FA (users.totp_secret) — مفتاح Fernet **مستقل** عن مفتاح النسخ الاحتياطي.
# إلزامي حين APP_ENV=production (الخادم يرفض الإقلاع بدونه). احفظه خارج git والنسخ السحابية.
# توليده: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# مهلة الخمول (دقائق) فوق السقف المطلق ٨ ساعات — الموظف ٣٠ (قرار المالك)، البوابة ١٥ (مقترَح)
STAFF_IDLE_TIMEOUT_MINUTES=30
PORTAL_IDLE_TIMEOUT_MINUTES=15

# §٩ النسخ الاحتياطي — مفتاح Fernet (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
BACKUP_ENCRYPTION_KEY=

# §٩ الوجهة الخارجية — مجلد محلي على السيرفر تُزامنه أداة سحابية لخارج السيرفر
# (الأداة المعتمدة: rclone، قرار المالك ٢٠٢٦-١٠-٠٦؛ الوجهة تُحدَّد لاحقاً). ضع هنا مسار
# مجلد المزامنة الحقيقي نفسه — لا يُنشَأ تلقائياً؛ غيابه = تحذير صريح.
# إلزامي: تحقُّق يدوي شهري أن الملفات تصل السحابة فعلاً (انظر README).
# فحص check-backup-freshness المجدول ينبّه critical إن لم تصل نسخة خلال ٤٨س.
BACKUP_OFFSITE_DIR=

# SFTP — بديل شبكي مباشر، غير مستخدَم بعد قرار BACKUP_OFFSITE_DIR أعلاه.
# اتركه فارغاً ما لم تُلغَ آلية مجلد المزامنة صراحةً.
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=
BACKUP_SFTP_KEY_PATH=
BACKUP_SFTP_REMOTE_DIR=

# فقط إن لم تكن pg_dump/pg_restore/psql على PATH (عادة على خادم لينكس تكون كذلك)
PG_DUMP_PATH=
PG_RESTORE_PATH=
PSQL_PATH=

# اتصال منفصل بصلاحية CREATEDB لاختبار الاستعادة إلى قاعدة مؤقتة — اتركه
# فارغاً لاستخدام DATABASE_URL نفسه (يتطلب حينها CREATEDB على ذلك الدور)
BACKUP_ADMIN_DATABASE_URL=

# مجلد النسخ المحلية المُشفَّرة. على السيرفر: /srv/wamda/backups (الخدمة تعمل من مجلد الكود فيجب ضبطه صراحةً)
BACKUP_DIR=backups
