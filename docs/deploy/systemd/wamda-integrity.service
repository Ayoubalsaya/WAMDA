# ومضة — مهمة مجدولة: daily integrity check (recompute-balances --verify). تُشغَّل بـwamda-integrity.timer. الفشل ← OnFailure ← تنبيه في لوحة التحكم؛ النجاح يمسح التنبيه.
[Unit]
Description=Wamda scheduled job: daily integrity check (recompute-balances --verify)
After=postgresql@18-main.service
Wants=postgresql@18-main.service
OnFailure=wamda-job-failed@integrity.service

[Service]
Type=oneshot
User=wamda
Group=wamda
WorkingDirectory=/srv/wamda/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/wamda/venv/bin/python -m app.cli daily-integrity-check
ExecStartPost=/srv/wamda/venv/bin/python -m app.cli job-status integrity --ok
TimeoutStartSec=900
SyslogIdentifier=wamda-integrity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/wamda/backups

ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077
Nice=10
