# ومضة — مهمة مجدولة: encrypted backup + offsite upload. تُشغَّل بـwamda-backup.timer. الفشل ← OnFailure ← تنبيه في لوحة التحكم؛ النجاح يمسح التنبيه.
[Unit]
Description=Wamda scheduled job: encrypted backup + offsite upload
After=postgresql@18-main.service
Wants=postgresql@18-main.service
OnFailure=wamda-job-failed@backup.service

[Service]
Type=oneshot
User=wamda
Group=wamda
WorkingDirectory=/srv/wamda/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/wamda/venv/bin/python -m app.cli backup
ExecStartPost=/srv/wamda/venv/bin/python -m app.cli job-status backup --ok
TimeoutStartSec=1800
SyslogIdentifier=wamda-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/wamda/backups
# عند ضبط BACKUP_OFFSITE_DIR (rclone/B2) أضف مساره هنا: ReadWritePaths=<مجلد المزامنة>
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077
Nice=10
