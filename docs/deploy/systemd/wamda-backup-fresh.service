# ومضة — مهمة مجدولة: offsite backup freshness check. تُشغَّل بـwamda-backup-fresh.timer. الفشل ← OnFailure ← تنبيه في لوحة التحكم؛ النجاح يمسح التنبيه.
[Unit]
Description=Wamda scheduled job: offsite backup freshness check
After=postgresql@18-main.service
Wants=postgresql@18-main.service
OnFailure=wamda-job-failed@backup-fresh.service

[Service]
Type=oneshot
User=wamda
Group=wamda
WorkingDirectory=/srv/wamda/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/wamda/venv/bin/python -m app.cli check-backup-freshness
ExecStartPost=/srv/wamda/venv/bin/python -m app.cli job-status backup-fresh --ok
TimeoutStartSec=300
SyslogIdentifier=wamda-backup-fresh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/wamda/backups
# يقرأ BACKUP_OFFSITE_DIR: أضف مساره هنا عند ضبطه (قراءة فقط يكفي: ReadOnlyPaths=<مجلد المزامنة>)
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077
Nice=10
