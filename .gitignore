# ناتج بناء الواجهة (frontend/ → npm run build) — يُبنى محلياً/عند
# النشر، لا يُلتزَم به. app/static/fonts وapp/static/uploads بيانات
# حقيقية لا ناتج بناء، تبقيان مُتتبَّعتين.
app/static/app/

# لقطات تحقُّق Playwright المحلية (سكربتات scripts/verify_*)
scripts/_*.png
backups/

# لقطات إعادة تصميم دفتر اليومية (scripts/qa_journal_redesign.py) — تُلتزَم
# فقط النتيجتان النهائيتان before/ وafter/ (شرط القبول: لقطة قبل وبعد لكل
# نوع)؛ أي تشغيل تجريبي آخر (--label dbg/before-dry/cleanup/…) مُتجاهَل.
docs/design/journal-redesign-shots/*
!docs/design/journal-redesign-shots/before
!docs/design/journal-redesign-shots/after
!docs/design/journal-redesign-shots/webkit
!docs/design/journal-redesign-shots/segtabs-repro
!docs/design/journal-redesign-shots/portal-invite-flow
shots_icons/
shots_credit/
shots_remit/
shots_lines/
shots_comm/
shots_wiz/

